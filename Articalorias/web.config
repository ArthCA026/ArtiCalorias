<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged with the aspNetCore handler section the SDK generates at publish.
  Only purpose: stop IIS / App Service from advertising the stack.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
